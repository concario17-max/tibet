{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src/utils/**/*.js",
    "src/utils/**/*.test.js",
    "scripts/lib/**/*.js",
    "scripts/parse_book_text.js",
    "scripts/extract_prayers.js",
    "scripts/validate_generated_data.js"
  ]
}
